# Turso Database (persistent — create manually with `turso db create`)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel-Turso integration auto-provisioned vars (fallback)
TURSO_DATABASE_VERCEL_TURSO_DATABASE_URL=
TURSO_DATABASE_VERCEL_TURSO_AUTH_TOKEN=

# WebAuthn (override for production)
APP_URL=http://localhost:4321
RP_ID=localhost
ORIGIN=http://localhost:4321

# JWT secret (change in production)
JWT_SECRET=dev-secret-change-in-production

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
PUBLIC_GOOGLE_CLIENT_ID=

# Google Analytics (optional)
PUBLIC_GA_MEASUREMENT_ID=

# Email verification (optional, defaults to console logging)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# WalletConnect (required for mobile wallet connection)
PUBLIC_WALLETCONNECT_PROJECT_ID=
