---
import '../styles/global.css';
import GoogleLogin from '../components/GoogleLogin';
import PasskeyLogin from '../components/PasskeyLogin';

const verified = Astro.url.searchParams.get("verified");
---

<!DOCTYPE html>
<html lang="en" data-theme="corporate" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign In · AI-Enable</title>
</head>
<body class="h-full">
  <main class="w-full h-full grid lg:grid-cols-[1fr_28rem] xl:grid-cols-[1fr_32rem]">
    <section class="h-full flex flex-col justify-center items-center p-6 lg:p-10">
      <a href="/" class="text-gray-900 flex mb-auto self-start justify-self-start -mt-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-9" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
      </a>

      <div class="w-full max-w-md mt-16 flex flex-col gap-y-2 mb-8 text-center">
        <h1 class="text-2xl md:text-3xl text-gray-900 font-bold">Sign in to your Account</h1>
      </div>

      <div class="w-full max-w-md mb-16">
        <GoogleLogin mode="login" client:load />

        <div class="flex flex-col gap-2 pb-4">
          <PasskeyLogin client:load />
        </div>

        <div class="relative my-2">
          <div class="absolute inset-0 flex items-center" aria-hidden="true">
            <div class="w-full border-t border-[#E9EFF5]"></div>
          </div>
          <div class="relative flex justify-center text-sm">
            <span class="px-2 bg-white text-gray-400 font-medium">or</span>
          </div>
        </div>

        {verified === "1" && (
          <div class="bg-green-50 border border-green-200 text-green-700 text-sm rounded-lg p-3 flex items-center gap-2 mt-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            Email verified! You can now log in.
          </div>
        )}
        {verified === "already" && (
          <div class="bg-blue-50 border border-blue-200 text-blue-700 text-sm rounded-lg p-3 flex items-center gap-2 mt-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            This email is already verified.
          </div>
        )}

        <button class="w-full py-3 px-4 bg-gray-900 text-white rounded-xl font-medium hover:bg-gray-800 transition flex items-center justify-center gap-2 mt-4" phx-click="toggleForm">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          Sign in with email
        </button>

        <form id="loginForm" class="card p-6 space-y-5 mt-6 hidden border border-gray-200 rounded-xl">
          <label class="block text-sm font-medium text-gray-900">
            Email
            <input type="email" name="email" class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent" placeholder="you@example.com" required />
          </label>

          <label class="block text-sm font-medium text-gray-900">
            Password
            <input type="password" name="password" class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent" placeholder="Enter your password" required />
          </label>

          <div id="errorMsg" class="text-red-600 text-sm hidden"></div>

          <button type="submit" class="w-full py-2.5 bg-gray-900 text-white rounded-xl font-medium hover:bg-gray-800 transition">Sign in</button>
        </form>

        <div class="text-center mt-6 pt-6 border-t-2 border-gray-300">
          <span class="text-sm text-gray-600">Don't have an account? </span>
          <a href="/register" class="text-sm text-gray-900 underline underline-offset-2 decoration-1 decoration-gray-300 hover:text-violet-600 transition-all">Create one</a>
        </div>
      </div>

      <footer class="mx-auto mt-auto w-full max-w-md text-xs pt-6">
        <div class="text-center text-gray-500">
          By signing in you agree to our
          <a href="/terms" class="text-gray-900 underline underline-offset-2 decoration-1 decoration-gray-300 hover:text-violet-600 transition-all">terms of service</a>
          and
          <a href="/privacy" class="text-gray-900 underline underline-offset-2 decoration-1 decoration-gray-300 hover:text-violet-600 transition-all">privacy policy</a>.
        </div>
      </footer>
    </section>

    <aside class="relative hidden lg:block h-full bg-gradient-to-br from-violet-600 via-violet-700 to-violet-900">
      <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iNDAwIiBoZWlnaHQ9IjYwMCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cGF0aCBkPSJNMCAwaDQwMHY2MDBIMHoiIGZpbGw9InJnYigyMjksMjI5LDIzMSkiLz48Y2lyY2xlIGN4PSI1MCIgY3k9IjUwIiByPSI0MCIgZmlsbD0icmdiKDIwMCwyMDAsMjA0KSIvPjwvc3ZnPg==')) opacity-10"></div>
      <div class="relative z-10 h-full flex flex-col justify-end p-10">
        <blockquote class="text-2xl text-violet-100 font-medium leading-snug">
          <p class="leading-tight">Authentication</p>
          <p class="leading-tight">It is me, please let me in</p>
          <p class="leading-tight">Why dost thou protest</p>
          <cite class="block not-italic text-xl mt-6 text-violet-200/70">
            <span class="opacity-40">&mdash;</span>A haiku by
            <span class="underline underline-offset-2 decoration-1 decoration-violet-300/40">jphenow</span>
          </cite>
        </blockquote>
      </div>
    </aside>
  </main>

  <script>
    const toggleBtn = document.querySelector('[phx-click="toggleForm"]');
    const form = document.getElementById("loginForm");
    const errorEl = document.getElementById("errorMsg");
    const inputs = form.querySelectorAll("input");

    if (toggleBtn) {
      toggleBtn.addEventListener("click", () => {
        form.classList.toggle("hidden");
        if (!form.classList.contains("hidden")) {
          setTimeout(() => inputs[0].focus(), 100);
        }
      });
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorEl.classList.add("hidden");
      const fd = new FormData(form);

      const resp = await fetch("/api/auth/login", {
        method: "POST",
        body: fd,
      });

      const data = await resp.json();

      if (data.ok) {
        window.location.href = "/dashboard";
      } else {
        errorEl.textContent = data.error || "Login failed";
        errorEl.classList.remove("hidden");
      }
    });
  </script>
</body>
</html>