---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en" data-theme="corporate" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AI-Enable — Build your site. Faster.</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet" />
  <style>
    body { font-family: 'Inter', system-ui, sans-serif; }
  </style>
</head>
<body class="bg-white text-gray-900 antialiased">
  <!-- Nav -->
  <nav class="flex items-center justify-between px-6 py-4 max-w-7xl mx-auto">
    <a href="/" class="flex items-center gap-2 font-bold text-xl tracking-tight">
      <svg xmlns="http://www.w3.org/2000/svg" class="size-7 text-violet-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
      AI-Enable
    </a>
    <div class="flex items-center gap-3">
      <a href="/login" class="text-sm font-medium text-gray-600 hover:text-gray-900 transition px-3 py-2">Log in</a>
      <a href="/register" class="text-sm font-semibold bg-gray-900 text-white px-5 py-2.5 rounded-xl hover:bg-gray-800 transition">Get started</a>
    </div>
  </nav>

  <!-- Hero -->
  <section class="px-6 pt-20 pb-16 max-w-7xl mx-auto text-center">
    <div class="inline-flex items-center gap-1.5 bg-violet-50 border border-violet-200 rounded-full px-4 py-1.5 text-sm text-violet-700 font-medium mb-8">
      <span class="size-2 bg-violet-500 rounded-full animate-pulse"></span>
      Now in early access
    </div>
    <h1 class="text-5xl md:text-7xl lg:text-8xl font-extrabold tracking-tight leading-[1.05] max-w-4xl mx-auto">
      Build your site.
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-600 to-indigo-500">Faster.</span>
    </h1>
    <p class="mt-6 text-lg md:text-xl text-gray-500 max-w-2xl mx-auto leading-relaxed">
      The visual site builder for modern teams. Drag, drop, and ship production-ready sites with hosting, analytics, and CMS built in.
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-10">
      <a href="/register" class="w-full sm:w-auto px-8 py-3.5 bg-gray-900 text-white rounded-xl font-semibold text-base hover:bg-gray-800 transition shadow-lg shadow-gray-900/10">Start building — free</a>
      <a href="#how" class="w-full sm:w-auto px-8 py-3.5 border border-gray-200 text-gray-700 rounded-xl font-semibold text-base hover:bg-gray-50 transition flex items-center justify-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        See how it works
      </a>
    </div>
  </section>

  <!-- Mockup -->
  <section class="px-6 pb-24 max-w-7xl mx-auto">
    <div class="relative rounded-2xl border border-gray-200 overflow-hidden shadow-2xl bg-gradient-to-b from-gray-50 to-white">
      <div class="flex items-center gap-1.5 px-4 py-3 border-b border-gray-100 bg-white">
        <span class="size-3 rounded-full bg-red-400"></span>
        <span class="size-3 rounded-full bg-yellow-400"></span>
        <span class="size-3 rounded-full bg-green-400"></span>
        <span class="ml-3 text-xs text-gray-400 font-mono">ai-enable.app / dashboard</span>
      </div>
      <div class="grid grid-cols-[16rem_1fr] h-80">
        <div class="border-r border-gray-100 p-4 space-y-3 bg-gray-50/50">
          <div class="h-7 bg-gray-200 rounded-lg w-24"></div>
          <div class="h-7 bg-gray-100 rounded-lg w-full"></div>
          <div class="h-7 bg-gray-100 rounded-lg w-3/4"></div>
          <div class="h-7 bg-gray-100 rounded-lg w-5/6"></div>
        </div>
        <div class="p-6 space-y-4">
          <div class="flex items-center gap-4">
            <div class="h-10 w-10 rounded-xl bg-violet-100 flex items-center justify-center">
              <svg class="size-5 text-violet-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            </div>
            <div class="flex-1 space-y-1.5">
              <div class="h-4 bg-gray-200 rounded w-48"></div>
              <div class="h-3 bg-gray-100 rounded w-32"></div>
            </div>
            <div class="h-8 w-20 bg-gray-200 rounded-lg"></div>
          </div>
          <div class="grid grid-cols-3 gap-4">
            <div class="h-32 bg-gray-100 rounded-xl"></div>
            <div class="h-32 bg-gray-100 rounded-xl"></div>
            <div class="h-32 bg-gray-100 rounded-xl"></div>
          </div>
          <div class="h-20 bg-gray-100 rounded-xl"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="px-6 py-24 max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight">Everything you need to ship</h2>
      <p class="mt-4 text-lg text-gray-500 max-w-xl mx-auto">Build, publish, and grow — all in one place. No code required.</p>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="rounded-2xl border border-gray-100 p-6 hover:border-gray-200 hover:shadow-sm transition">
        <div class="size-12 rounded-xl bg-violet-100 flex items-center justify-center mb-4">
          <svg class="size-6 text-violet-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" /></svg>
        </div>
        <h3 class="font-semibold text-lg mb-1">Visual Builder</h3>
        <p class="text-sm text-gray-500 leading-relaxed">Drag-and-drop interface to design responsive layouts. Real-time preview on every device.</p>
      </div>
      <div class="rounded-2xl border border-gray-100 p-6 hover:border-gray-200 hover:shadow-sm transition">
        <div class="size-12 rounded-xl bg-indigo-100 flex items-center justify-center mb-4">
          <svg class="size-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
        </div>
        <h3 class="font-semibold text-lg mb-1">Templates</h3>
        <p class="text-sm text-gray-500 leading-relaxed">Start from 100+ professional templates. Fully customizable to match your brand.</p>
      </div>
      <div class="rounded-2xl border border-gray-100 p-6 hover:border-gray-200 hover:shadow-sm transition">
        <div class="size-12 rounded-xl bg-cyan-100 flex items-center justify-center mb-4">
          <svg class="size-6 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>
        </div>
        <h3 class="font-semibold text-lg mb-1">Global Hosting</h3>
        <p class="text-sm text-gray-500 leading-relaxed">Fast CDN with 30+ edge locations. Custom domains, SSL, and automatic scaling included.</p>
      </div>
      <div class="rounded-2xl border border-gray-100 p-6 hover:border-gray-200 hover:shadow-sm transition">
        <div class="size-12 rounded-xl bg-amber-100 flex items-center justify-center mb-4">
          <svg class="size-6 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
        </div>
        <h3 class="font-semibold text-lg mb-1">Analytics</h3>
        <p class="text-sm text-gray-500 leading-relaxed">Real-time traffic, page views, and conversion tracking. No extra tools needed.</p>
      </div>
    </div>
  </section>

  <!-- Scale section -->
  <section class="px-6 py-24 bg-gray-50/80">
    <div class="max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-3xl md:text-5xl font-bold tracking-tight leading-tight">Scale without switching tools</h2>
          <p class="mt-4 text-lg text-gray-500 leading-relaxed">From your first site to your hundredth — built-in CMS, SEO, localization, and team collaboration grow with you.</p>
          <div class="mt-8 space-y-5">
            <div class="flex gap-4">
              <div class="size-6 mt-0.5 shrink-0 rounded-full bg-green-100 flex items-center justify-center">
                <svg class="size-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              </div>
              <div><span class="font-semibold">Built-in CMS</span> <span class="text-gray-500">— manage content without touching code</span></div>
            </div>
            <div class="flex gap-4">
              <div class="size-6 mt-0.5 shrink-0 rounded-full bg-green-100 flex items-center justify-center">
                <svg class="size-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              </div>
              <div><span class="font-semibold">SEO & Performance</span> <span class="text-gray-500">— perfect Lighthouse scores out of the box</span></div>
            </div>
            <div class="flex gap-4">
              <div class="size-6 mt-0.5 shrink-0 rounded-full bg-green-100 flex items-center justify-center">
                <svg class="size-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              </div>
              <div><span class="font-semibold">Real-time Collaboration</span> <span class="text-gray-500">— comment, edit, and publish together</span></div>
            </div>
          </div>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-lg">
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center gap-2">
              <div class="size-3 rounded-full bg-green-400"></div>
              <span class="text-sm font-semibold">Live — 99.9% uptime</span>
            </div>
            <span class="text-sm text-gray-400">Last 30 days</span>
          </div>
          <div class="space-y-4">
            <div>
              <div class="flex justify-between text-sm mb-1"><span class="text-gray-500">Pageviews</span><span class="font-semibold">258,156</span></div>
              <div class="h-2 bg-gray-100 rounded-full overflow-hidden"><div class="h-full w-3/4 bg-violet-500 rounded-full"></div></div>
            </div>
            <div>
              <div class="flex justify-between text-sm mb-1"><span class="text-gray-500">Visitors</span><span class="font-semibold">85,458</span></div>
              <div class="h-2 bg-gray-100 rounded-full overflow-hidden"><div class="h-full w-1/2 bg-indigo-500 rounded-full"></div></div>
            </div>
            <div>
              <div class="flex justify-between text-sm mb-1"><span class="text-gray-500">Avg. Load Time</span><span class="font-semibold">43ms</span></div>
              <div class="h-2 bg-gray-100 rounded-full overflow-hidden"><div class="h-full w-5/6 bg-green-500 rounded-full"></div></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="px-6 py-24 max-w-7xl mx-auto">
    <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-center mb-16">Trusted by teams shipping daily</h2>
    <div class="grid md:grid-cols-3 gap-6">
      <div class="rounded-2xl border border-gray-100 p-6">
        <div class="flex items-center gap-1 mb-4">
          {[...Array(5)].map((_, i) => <svg key={i} class="size-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>)}
        </div>
        <p class="text-gray-600 text-sm leading-relaxed mb-4">"We migrated our entire marketing site in two days. The visual builder is incredibly intuitive."</p>
        <div class="flex items-center gap-3">
          <div class="size-9 rounded-full bg-violet-100 flex items-center justify-center text-sm font-semibold text-violet-600">SK</div>
          <div><div class="text-sm font-semibold">Sarah Kim</div><div class="text-xs text-gray-400">Design Lead, Linear</div></div>
        </div>
      </div>
      <div class="rounded-2xl border border-gray-100 p-6">
        <div class="flex items-center gap-1 mb-4">
          {[...Array(5)].map((_, i) => <svg key={i} class="size-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>)}
        </div>
        <p class="text-gray-600 text-sm leading-relaxed mb-4">"Built our entire documentation site in an afternoon. The CMS + hosting combo is a game changer."</p>
        <div class="flex items-center gap-3">
          <div class="size-9 rounded-full bg-indigo-100 flex items-center justify-center text-sm font-semibold text-indigo-600">MR</div>
          <div><div class="text-sm font-semibold">Marcus Rojas</div><div class="text-xs text-gray-400">Engineer, Vercel</div></div>
        </div>
      </div>
      <div class="rounded-2xl border border-gray-100 p-6">
        <div class="flex items-center gap-1 mb-4">
          {[...Array(5)].map((_, i) => <svg key={i} class="size-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>)}
        </div>
        <p class="text-gray-600 text-sm leading-relaxed mb-4">"No more dev handoff bottlenecks. Our designers ship directly. The velocity improvement is real."</p>
        <div class="flex items-center gap-3">
          <div class="size-9 rounded-full bg-cyan-100 flex items-center justify-center text-sm font-semibold text-cyan-600">AL</div>
          <div><div class="text-sm font-semibold">Aiko Lee</div><div class="text-xs text-gray-400">Product, Notion</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="px-6 py-24 bg-gray-900 text-white">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight">Start building today</h2>
      <p class="mt-4 text-lg text-gray-400 max-w-lg mx-auto">Free plan includes hosting, custom domain, and all core features. No credit card required.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-10">
        <a href="/register" class="px-8 py-3.5 bg-white text-gray-900 rounded-xl font-semibold hover:bg-gray-100 transition shadow-lg">Get started free</a>
        <a href="/login" class="px-8 py-3.5 border border-gray-700 text-gray-300 rounded-xl font-semibold hover:bg-gray-800 transition">Sign in</a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="px-6 py-12 border-t border-gray-100">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2 font-semibold text-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-violet-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
        AI-Enable
      </div>
      <div class="flex items-center gap-6 text-sm text-gray-400">
        <a href="#" class="hover:text-gray-600 transition">Privacy</a>
        <a href="#" class="hover:text-gray-600 transition">Terms</a>
        <a href="#" class="hover:text-gray-600 transition">Docs</a>
        <a href="#" class="hover:text-gray-600 transition">Status</a>
      </div>
      <span class="text-sm text-gray-400">&copy; 2026 AI-Enable, Inc.</span>
    </div>
  </footer>
</body>
</html>